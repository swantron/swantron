{{- $posts := where .Site.RegularPages "Type" "posts" -}}
{{- $.Scratch.Set "ids" dict -}}
{{- range $posts -}}
{{- $id := printf "%v" .Params.id -}}
{{- $seen := $.Scratch.Get "ids" -}}
{{- if index $seen $id -}}
{{- errorf "Duplicate post id %s on %s and %s" $id .File.Path (index $seen $id) -}}
{{- end -}}
{{- $.Scratch.Set "ids" (merge $seen (dict $id .File.Path)) -}}
{{- end -}}
{
  "posts": [
    {{- range $index, $post := $posts -}}
    {{- if $index }},{{- end }}
    {{- partial "api-post.html" (dict "page" $post "content" false) -}}
    {{- end -}}
  ],
  "total": {{ len $posts }}
}
