# WordPress export (contains sensitive data - database backups, config files)
wp-export/

# Large archive files (exceed GitHub's 100MB limit)
**/*.zip
static/uploads/**/*.zip

# Conversion script (optional, can be removed)
convert_posts.py

# Hugo build output
/public/
/resources/_gen/
.hugo_build.lock

# OS files
.DS_Store
Thumbs.db

# Editor files
.idea/
.vscode/
*.swp
*.swo
*~

# Sensitive WordPress files (should not be in static/uploads)
**/wp-config.php
**/*.sql
**/wp-*.php
**/xmlrpc.php
**/install.php
**/wp-snapshots/
